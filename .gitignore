# ============================================================================
# 雁书 Gaggle · 仓库根 .gitignore
#
# 原则：源码 / 文档 / 构建脚本 入库；
#       模型、推理引擎、用户数据（音频+数据库）、安装包、密钥 一律不入库。
#
# 如果你新增了「体积大」或「只属于本机」的目录，请先加到这里，
# 再运行 scripts\push-to-github.ps1 —— 脚本会校验关键路径是否已被忽略。
# ============================================================================

# ---------------------------------------------------------------------------
# 一、本机运行时数据（最容易被误传，逐项保留）
# ---------------------------------------------------------------------------
# 用户数据目录：gaggle.db / models / audio / engine / logs / tmp
workspace/

# 打包产物：Setup.exe + APK（走 GitHub Release 发布，不进仓库）
dist/

# 技术验证用的 exe / 模型散件
spikes/

# 早期 Flutter 原型副本（已被 app/lib 取代）
_src/

# ---------------------------------------------------------------------------
# 二、密钥与个人配置（一旦泄露只能换 key）
# ---------------------------------------------------------------------------
tools/agent_config.json
tools/agent_config.*.json
!tools/agent_config.example.json
app/android/local.properties
key.properties
*.keystore
*.jks
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# 三、Python（tools/ 下的 diarizer、A2A server）
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
# PyInstaller 中间产物与产物
tools/build/
tools/dist/
*.spec.bak

# ---------------------------------------------------------------------------
# 四、模型与推理引擎二进制（GB 级，禁止入库）
# ---------------------------------------------------------------------------
*.bin
*.onnx
*.gguf
*.pt
*.pth
*.safetensors
# 随包分发的 ffmpeg / whisper-cli / diarizer
app/windows/engine/
**/engine/

# ---------------------------------------------------------------------------
# 五、音视频（测试素材 / 用户录音）
# ---------------------------------------------------------------------------
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.mp4

# ---------------------------------------------------------------------------
# 六、数据库
# ---------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# 七、日志与临时文件
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
*.tmp
*.bak

# ---------------------------------------------------------------------------
# 八、Flutter / Dart
# ---------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
coverage/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.metadata.bak
app/.dart_tool/
app/build/
app/coverage/
app/windows/flutter/ephemeral/
app/android/.gradle/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/.flutter-plugins-dependencies

# ---------------------------------------------------------------------------
# 九、IDE / 系统
# ---------------------------------------------------------------------------
.idea/
.vscode/
.history/
*.swp
.DS_Store
Thumbs.db
desktop.ini
